# Yolna Runs — standalone runtime environment (SOR-135 Phase 4A)
#
# This file lists ONLY the environment variables the standalone Runs
# application actually reads, audited directly from source — see
# lib/env/runtimeEnvContract.ts, the machine-checked source of truth (also
# enforced at runtime/CI by `npm run verify:env`). Do not copy variables
# from Yolna root's own .env.example into this file — see that same
# module's FORBIDDEN_SECRET_NAMES/FORBIDDEN_SECRET_PREFIXES for the full
# list of Yolna-only secrets this deployment must never hold.
#
# Never commit real secret VALUES to this file or any other file in the repo.

# --- Public (required) ---
# Safe to expose to the browser bundle (NEXT_PUBLIC_* is inlined at build time).

# Runs-owned Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Runs-owned Supabase anon key (RLS-scoped, browser-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (required) ---
# Never bundled to the browser. Never prefix a server-only var with
# NEXT_PUBLIC_. See scripts/verify/runsClientServerBoundary.ts for the
# static check enforcing that no client component's import graph can
# reach the module that reads this value.

# Runs-owned Supabase service-role key. Used only by packages/runs-core's
# database/supabaseServiceRole.ts and, transitively, Runs Core's own
# store/RPC call sites.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server-only (optional) ---

# Shared-secret bearer credential for POST /api/tact/runs/ingest/** (the
# Yolna -> Runs projection write path, see lib/projection/ingestionAuth.ts).
# Unset means those endpoints reject every request (fail-closed) — this is
# NOT request signing, a nonce, or replay prevention; those remain SOR-8's
# responsibility and are not implemented by this token.
RUNS_PROJECTION_INGESTION_TOKEN=

# JSON map of public sourceId:keyId to base64 HMAC verification key. Never commit a real value.
RUNS_TELEMETRY_HMAC_KEYS_JSON=

# JSON map of "<callerId>:<keyId>" to base64 HMAC verification key for the
# governance S2S boundary (POST /api/tact/runs/governance/{preflight,complete},
# SOR-138 Slice 3A-1). A distinct credential from RUNS_TELEMETRY_HMAC_KEYS_JSON
# above — see lib/governance/runsGovernanceAuth.ts's header comment. Never
# commit a real value.
RUNS_GOVERNANCE_HMAC_KEYS_JSON=
