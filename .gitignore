# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except templates: these are meant to be committed (no real secret
# values), at the repo root and in every nested package/app (e.g.
# products/yolna-runs/.env.example, SOR-135 Phase 4A).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime execution logs (Legacy Workflow debug dumps; can contain real
# user prompt content, not source code — excluded from Phase 1-10
# orchestration commit per explicit user decision)
/logs/

# Supabase CLI local state (project-ref, pooler-url, etc.) — not source
# code, machine-local tool state
/supabase/.temp/
/supabase/.branches/
/supabase/config.toml

# SOR-135 Phase 2: packages/* and products/* (e.g. products/yolna-runs)
# are each independently `npm install`-able and have their own
# node_modules/.next/build output. The rooted patterns above (/node_modules,
# /.next/, /out/, /build) only match the repo root, so each is repeated
# here unrooted to also cover every nested package/app.
node_modules/
.next/
out/
build/
